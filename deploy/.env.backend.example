# Copy to the repository root as .env on the backend host.
# Replace every example value before exposing the edge profile to the Internet.
POSTGRES_USER=omnibid
POSTGRES_PASSWORD=replace-with-a-long-random-password
RABBITMQ_DEFAULT_USER=omnibid
RABBITMQ_DEFAULT_PASS=replace-with-a-different-long-random-password

OMNIBID_IMAGE_TAG=local
INFRA_BIND_ADDRESS=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1
IDENTITY_ACTIVE_PROFILE=production

OMNIBID_DOMAIN=example.com
ACME_EMAIL=admin@example.com
OMNIBID_TOKEN_ISSUER=https://identity.example.com
OMNIBID_TOKEN_AUDIENCE=omnibid-api
FRONTEND_ORIGINS=https://omnibid.vercel.app

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
